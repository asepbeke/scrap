# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=streamvault-secret-key-change-in-production-2026
PORT=5000
DEBUG=True

# Playwright Chrome DevTools Protocol (CDP)
CDP_HOST=127.0.0.1
CDP_PORT=9222
CDP_TIMEOUT=5000

# Scraper Throttling (ms)
SCRAPER_DELAY_MS=2000

# Default Thread
DEFAULT_THREAD=live_show
